---
import Layout from "../layouts/layout.astro";
import Header from "../components/header.astro"
// import config from "../../config/baseConfig";
import { hypnose } from "../../config/contentConfig"
---
<Layout title="Hypnose">
    <Header/>
    <br>
    <main>
        <div class="about">
            <h1 class="title">Hypnose</h1>
            <!-- <img src={"/" + config.base + "/maike2.jpeg"}> -->
            <div class="info">
                <Fragment set:html={hypnose}/>
            </div>
        </div>
    </main>
</Layout>
<style>
    .about {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin-top: 2rem;
    }
    .about .title {
        font-size: 3rem;
        font-weight: 600;
    }
    .about .info {
        display: flex;
        flex-direction: column;
        width: 100%;
        font-weight: 500
    }
</style>